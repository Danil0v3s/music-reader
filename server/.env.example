# Copy to .env (next to docker-compose.yml) and fill in.

# Where people reach the server; used in the links of account emails.
OMR_PUBLIC_URL=https://music.example.com
# With the HTTPS proxy (docker compose --profile public up -d): its domain, and trust its forwarded addresses.
OMR_DOMAIN=music.example.com
OMR_TRUST_PROXY=1

# Sign in with Apple: the app's bundle id. Google Sign-In: the iOS OAuth client id from Google Cloud
# (APIs & Services → Credentials → OAuth client ID → iOS). Leave Google empty to turn it off.
OMR_APPLE_AUDIENCE=br.com.firstsoft.musicreader
OMR_GOOGLE_CLIENT_IDS=

# The Sign in with Apple key (Apple Developer → Keys → new key with Sign in with Apple), so deleting an
# account also revokes its Apple sign-in, as the App Store requires. Put the .p8 next to this file.
OMR_APPLE_TEAM_ID=
OMR_APPLE_KEY_ID=
OMR_APPLE_PRIVATE_KEY_FILE=/run/secrets/apple.p8

# Account emails (verify address, reset password). Without a host they're only written to the log.
OMR_SMTP_HOST=
OMR_SMTP_PORT=587
OMR_SMTP_USER=
OMR_SMTP_PASSWORD=
OMR_MAIL_FROM=Music Reader <no-reply@example.com>

OMR_FINGERINGS=1
